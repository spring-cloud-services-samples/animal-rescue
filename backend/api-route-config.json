{
  "routes": [
    {
      "title": "Retrieve pets for adoption (v2, paginated).",
      "description": "Retrieve animals with pagination. Requires API-Version: 2.0 header.",
      "path": "/api/animals",
      "method": "GET",
      "predicates": [ "Header=API-Version,2.0" ],
      "filters": [ "RateLimit=2,10s" ],
      "order": 0,
      "tags": ["pet adoption"]
    },
    {
      "title": "Retrieve pets for adoption.",
      "description": "Retrieve all of the animals who are up for pet adoption.",
      "path": "/api/animals",
      "method": "GET",
      "filters": [ "RateLimit=2,10s" ],
      "order": 10,
      "tags": ["pet adoption"]
    },
    {
      "title": "Retrieve user information",
      "description": "Retrieve the current authenticated user's information.",
      "path": "/api/whoami",
      "method": "GET",
      "sso-enabled": true,
      "filters": [ "ClaimHeader=user_name,X-User-Name", "ClaimHeader=sub,X-User-Sub" ],
      "tags": ["sso"]
    },
    {
      "title": "Pet adoption API",
      "description": "Create pet adoption requests.",
      "path": "/api/animals/{animalId}/adoption-requests",
      "method": "POST",
      "sso-enabled": true,
      "filters": [ "ClaimHeader=user_name,X-User-Name", "ClaimHeader=sub,X-User-Sub" ],
      "tags": ["pet adoption"],
      "model": {
        "requestBody": {
          "description": "Manage adoption requests",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Adoption request schema",
                "properties": {
                  "adopterName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [ "adopterName", "email" ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Adoption request created successfully."
          }
        }
      }
    },
    {
      "title": "Pet adoption API",
      "description": "Update/delete pet adoption requests.",
      "path": "/api/animals/{animalId}/adoption-requests/{adoptionId}",
      "method": "PUT,DELETE",
      "sso-enabled": true,
      "filters": [ "ClaimHeader=user_name,X-User-Name", "ClaimHeader=sub,X-User-Sub" ],
      "tags": ["pet adoption"],
      "model": {
        "requestBody": {
          "description": "Manage adoption requests",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Adoption request schema",
                "properties": {
                  "adopterName": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [ "adopterName", "email" ]
              }
            }
          }
        }
      }
    }
  ]
}
